PORT=4000

# PostgreSQL connection. Copy this file to ".env" and adjust to your environment.
PGHOST=localhost
PGPORT=5432
PGDATABASE=rrhh
PGUSER=postgres
PGPASSWORD=postgres

# Días corridos que dura el período de prueba (por defecto 180, art. 92 bis LCT).
PERIODO_PRUEBA_DIAS=180

# Clave secreta para firmar las sesiones de acceso (login). Poné cualquier texto
# largo y aleatorio propio — no compartas este valor.
JWT_SECRET=cambiar-esto-por-un-texto-largo-y-aleatorio-propio

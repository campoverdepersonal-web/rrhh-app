# Variables de entorno del frontend para producción (Render, Vercel, Netlify, etc.)
#
# En tu computadora (npm run dev) NO hace falta este archivo: el proyecto usa
# el proxy de Vite hacia http://localhost:4000 automáticamente.
#
# Cuando publiques el frontend en internet, necesitás decirle en qué dirección
# quedó el backend. Copiá este archivo a ".env.production" y completá la URL
# real que te da Render para tu backend (Parte 2 de la guía de publicación).

VITE_API_URL=https://TU-BACKEND.onrender.com
